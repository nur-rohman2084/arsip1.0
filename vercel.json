{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://domain-backend-express-anda.com/api/:path*"
    }
  ]
}
